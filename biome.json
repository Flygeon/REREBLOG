{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.vue",
      "scripts/**/*.mjs",
      "tests/**/*.ts",
      "*.ts",
      "!!src/generated",
      "!!src/content",
      "!!dist",
      "!!dist-ssr",
      "!!_legacy"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "error"
      },
      "style": {
        "useTemplate": "off",
        "useVueMultiWordComponentNames": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "useOptionalChain": "off"
      }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" }
        }
      }
    },
    {
      "includes": ["**/*.mjs", "**/*.cjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noControlCharactersInRegex": "off",
            "useIterableCallbackReturn": "off",
            "noAssignInExpressions": "off"
          },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}