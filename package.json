{
  "name": "flygeon-blog-vue",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Flygeonの小站 — 基于模板 UI（Material Design 3）+ Vue 3 + Vite 自建 SSG 的个人博客",
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:ssg",
    "clean": "node scripts/clean.mjs",
    "build:ssg": "node scripts/clean.mjs && node scripts/bangumi.mjs && vite build --config vite.ssr.config.ts && node scripts/render-content.mjs && vite build && node scripts/ssg.mjs && node scripts/sitemap-rss.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --config vite.ssr.config.ts",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@varlet/ui": "^3.6.2",
    "buffer": "^6.0.3",
    "sanitize-html": "^2.17.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/server-renderer": "^3.5.13",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "sass": "^1.83.0",
    "shiki": "^1.26.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.127.1"
  }
}
